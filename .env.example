# Copia a .env.local y rellena. No subas .env.local a git.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SHOP_ENABLED=true

# Hero: botón "Quiero entrar al drop" (true = visible, omitir o false = oculto)
NEXT_PUBLIC_HERO_DROP_CTA_ENABLED=false

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Email (Resend): admin + confirmación al cliente
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=onboarding@resend.dev
NOTIFY_EMAIL_TO=tu-correo@dominio.com
# Remitente para el comprador (opcional; si no, usa NOTIFY_EMAIL_FROM)
CUSTOMER_EMAIL_FROM=Kiosco <onboarding@resend.dev>
NEXT_PUBLIC_SUPPORT_WHATSAPP=https://wa.me/584147613621

# Notificaciones por Telegram (instantáneo)
# Crea bot en @BotFather, copia el token y tu chat_id (o grupo).
TELEGRAM_BOT_TOKEN=
# Puedes poner varios chat IDs separados por coma
TELEGRAM_CHAT_ID=

# Datos visibles en checkout para pagos manuales
NEXT_PUBLIC_PAGO_MOVIL_BANK=
NEXT_PUBLIC_PAGO_MOVIL_PHONE=
NEXT_PUBLIC_PAGO_MOVIL_ID=
NEXT_PUBLIC_PAGO_MOVIL_NAME=

NEXT_PUBLIC_BINANCE_PAY_ID=
NEXT_PUBLIC_BINANCE_EMAIL=
NEXT_PUBLIC_BINANCE_QR_URL=

NEXT_PUBLIC_ZINLI_EMAIL=
NEXT_PUBLIC_ZINLI_NAME=
NEXT_PUBLIC_ZINLI_QR_URL=
